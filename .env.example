# Fichier .env.example — Modèle de configuration (CE FICHIER EST PUBLIE SUR GITHUB)
# Renommer ce fichier en .env et remplir avec vos vraies valeurs.

DJANGO_SECRET_KEY=votre-cle-secrete-django-ici

# Gmail SMTP (utiliser un mot de passe d'application Google, pas le mot de passe habituel)
EMAIL_HOST_USER=votre-adresse@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
ALERT_EMAIL_RECIPIENT=votre-adresse@gmail.com

# Telegram Bot (créer un bot via @BotFather)
TELEGRAM_TOKEN=VOTRE_TOKEN_TELEGRAM
TELEGRAM_CHAT_ID=VOTRE_CHAT_ID

# Seuil d'alerte température (°C) — au-dessus de cette valeur, les alertes sont déclenchées
TEMP_ALERT_THRESHOLD=28
